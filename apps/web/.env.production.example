# ==============================================================================
# Benim Payım Web — Production Environment Variables (.env.production)
# Vercel Dashboard -> Project Settings -> Environment Variables
# ==============================================================================

# Render / Railway üzerinde çalışan canlı FastAPI Backend URL'si
NEXT_PUBLIC_API_URL=https://benim-payim-api.onrender.com

# Supabase Canlı Veritabanı ve Auth URL & Anon Key (Supabase Dashboard -> Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-public-key
