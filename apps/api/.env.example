# ==============================================================================
# Benim Payım API — Ortam Değişkenleri
# ==============================================================================

ENVIRONMENT=development
DEBUG=true

# Supabase Yapılandırması
# Gerçek Supabase projenizin Dashboard -> Project Settings -> API & Auth bölümlerinden alınır
SUPABASE_URL=http://localhost:54321
SUPABASE_ANON_KEY=demo-anon-key
SUPABASE_SERVICE_ROLE_KEY=demo-service-role-key
SUPABASE_JWT_SECRET=super-secret-jwt-token-with-at-least-32-bytes-length!
SUPABASE_JWT_AUDIENCE=authenticated
SUPABASE_JWT_ALGORITHM=HS256

# AI Sağlayıcı Yapılandırması (Ücretsiz Groq Llama 3.3 veya Gemini)
# GROQ_API_KEY boşsa deterministik Demo Adapter çalışır
AI_PROVIDER=groq
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash


# Hız Sınırları
RATE_LIMIT_PER_MINUTE=30
MAX_INPUT_CHARS=15000

# CORS Origins (JSON listesi)
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000","http://localhost:8000"]
